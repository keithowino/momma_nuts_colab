{
	"name": "deepseek_instance",
	"version": "1.0.0",
	"description": "Momma Nuts Full Stack App - Peanut E-commerce Platform",
	"main": "index.js",
	"scripts": {
		"dev": "concurrently \"npm run server\" \"npm run client\" --names \"🟦SERVER,🟩CLIENT\" --prefix-colors \"blue,green\"",
		"dev:verbose": "concurrently \"npm run server\" \"npm run client\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" --kill-others --raw",
		"dev:server-only": "cd server && python -m pipenv run python app.py",
		"dev:client-only": "cd client && npm run dev",
		"server": "cd server && python -m pipenv run python app.py",
		"client": "cd client && npm run dev",
		"build": "cd client && npm run build",
		"build:client": "cd client && npm run build",
		"install:all": "npm install && cd server && python -m pipenv install && cd client && npm install",
		"install:server": "cd server && python -m pipenv install",
		"install:client": "cd client && npm install",
		"setup": "npm run install:all && echo '🎉 Setup complete! Run npm run dev to start'",
		"clean": "rimraf node_modules client/node_modules server/.venv",
		"clean:install": "npm run clean && npm run install:all",
		"status": "echo '✅ Server: http://127.0.0.1:5000 | ✅ Client: http://localhost:3000'",
		"logs:server": "cd server && tail -f server.log || echo 'No log file found'",
		"logs:client": "cd client && npm run dev --silent",
		"kill": "npx kill-port 5000 3000"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keithowino/momma_nuts_colab.git"
	},
	"keywords": [
		"ecommerce",
		"momma-nuts",
		"flask",
		"react",
		"mpesa",
		"peanuts"
	],
	"author": "Keith Owino",
	"license": "ISC",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/keithowino/momma_nuts_colab/issues"
	},
	"homepage": "https://github.com/keithowino/momma_nuts_colab#readme",
	"dependencies": {
		"concurrently": "^10.0.3",
		"rimraf": "^6.1.3"
	},
	"devDependencies": {
		"kill-port": "^2.0.1"
	}
}
